{
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp-to-trello",
        "options": {}
      },
      "id": "6d7f8a1a-4d9b-4e6a-8c9e-6b7f8a1a4d9b",
      "name": "Webhook WhatsApp",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "sender_name",
              "value": "={{ $json.body.data.pushName || 'Desconhecido' }}"
            },
            {
              "name": "message_text",
              "value": "={{ $json.body.data.message.conversation || $json.body.data.message.extendedTextMessage.text }}"
            },
            {
              "name": "sender_number",
              "value": "={{ $json.body.data.key.remoteJid }}"
            }
          ]
        },
        "options": {}
      },
      "id": "7e8f9b2b-5e0c-5f7b-9d0f-7c8f9b2b5e0c",
      "name": "Extract Fields",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "listId": "YOUR_LIST_ID_HERE",
        "name": "=Novo Card de {{ $json.sender_name }}",
        "description": "={{ $json.message_text }}\n\nEnviado por: {{ $json.sender_number }}",
        "additionalFields": {}
      },
      "id": "8f9a0c3c-6f1d-6a8c-0e1g-8d9a0c3c6f1d",
      "name": "Trello",
      "type": "n8n-nodes-base.trello",
      "typeVersion": 1,
      "position": [
        650,
        300
      ],
      "credentials": {
        "trelloApi": {
          "id": "YOUR_TRELLO_CREDENTIAL_ID",
          "name": "Trello account"
        }
      }
    }
  ],
  "connections": {
    "Webhook WhatsApp": {
      "main": [
        [
          {
            "node": "Extract Fields",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Fields": {
      "main": [
        [
          {
            "node": "Trello",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
