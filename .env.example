# n8n Configuration
N8N_HOST=n8n.vivercatolico.com.br
N8N_PORT=5678
N8N_PROTOCOL=https

# Webhook URL (Crucial for WhatsApp/Trello triggers)
# Example: https://n8n.yourdomain.com/ or your Ngrok URL
WEBHOOK_URL=https://n8n.vivercatolico.com.br/

# Security
# Generate a random string for N8N_ENCRYPTION_KEY
N8N_ENCRYPTION_KEY=your_secure_random_key_here

# Localization
TIMEZONE=America/Sao_Paulo
