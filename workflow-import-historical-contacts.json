{
  "name": "🔄 Importar Contatos Históricos do WhatsApp → Trello",
  "nodes": [
    {
      "parameters": {},
      "id": "node-manual-trigger",
      "name": "Iniciar Importação Manual",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [-700, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.trello.com/1/lists/6a1494722dc95789afdde75c/cards",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "trelloApi",
        "options": {}
      },
      "id": "node-get-trello-cards",
      "name": "Obter Cards Trello",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [-480, 300],
      "credentials": {
        "trelloApi": {
          "id": "WGhjY0TBSOX8LgMk",
          "name": "Trello account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Agrupa todos os cards retornados do Trello em um único item para que o próximo nó rode apenas 1 vez\nreturn [{\n  json: {\n    cards: $input.all().map(item => item.json)\n  }\n}];"
      },
      "id": "node-agrupar-cards",
      "name": "Agrupar Cards Trello",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-260, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://evolution:8080/chat/findContacts/{{ $env.EVOLUTION_INSTANCE || 'meu-numero' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "apikey",
              "value": "evo-zap-agabo-2026"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}",
        "options": {}
      },
      "id": "node-get-evolution-contacts",
      "name": "Obter Contatos Evolution",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [-40, 300]
    },
    {
      "parameters": {
        "jsCode": "// ═══════════════════════════════════════════════════════\n// Filtra contatos que não existem no Trello (sem duplicados)\n// ═══════════════════════════════════════════════════════\n\nconst contactsItems = $input.all();\nconst cardsData = $(\"Agrupar Cards Trello\").first().json.cards || [];\n\nconst existingCards = cardsData.map(card => ({\n  name: (card.name || '').toLowerCase(),\n  desc: (card.desc || '').toLowerCase()\n}));\n\nconst newLeads = [];\n\nfor (const contact of contactsItems) {\n  const rawJid = contact.json.remoteJid || '';\n  if (contact.json.isGroup === true || !rawJid) continue;\n\n  const phone = rawJid.split('@')[0];\n  const pushName = (contact.json.pushName || '').trim();\n\n  const alreadyExists = existingCards.some(card => \n    card.name.includes(phone) || card.desc.includes(phone)\n  );\n\n  if (!alreadyExists) {\n    const displayName = pushName || 'Desconhecido';\n    const now = new Date().toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' });\n    \n    newLeads.push({\n      json: {\n        phone,\n        pushName: displayName,\n        cardTitle: pushName ? `${pushName} (${phone})` : `Lead ${phone}`,\n        cardDescription: \n          `📲 Lead importador historicamente via WhatsApp\\n` +\n          `Fonte: Evolution API (Histórico)\\n\\n` +\n          `Nome: ${displayName}\\n` +\n          `Número: ${phone}\\n` +\n          `Importado em: ${now}`\n      }\n    });\n  }\n}\n\nreturn newLeads;"
      },
      "id": "node-compare-leads",
      "name": "Filtrar Apenas Novos Leads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [180, 300]
    },
    {
      "parameters": {
        "batchSize": 80,
        "options": {}
      },
      "id": "node-split-batches",
      "name": "Split in Batches",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [400, 300]
    },
    {
      "parameters": {
        "listId": "6a1494722dc95789afdde75c",
        "name": "={{ $json.cardTitle }}",
        "description": "={{ $json.cardDescription }}",
        "additionalFields": {
          "pos": "top"
        }
      },
      "id": "node-create-trello-card",
      "name": "Criar Card no Trello",
      "type": "n8n-nodes-base.trello",
      "typeVersion": 1,
      "position": [640, 200],
      "credentials": {
        "trelloApi": {
          "id": "WGhjY0TBSOX8LgMk",
          "name": "Trello account"
        }
      }
    },
    {
      "parameters": {
        "amount": 10,
        "unit": "seconds"
      },
      "id": "node-wait-10s",
      "name": "Esperar 10 Segundos",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [880, 200]
    }
  ],
