    {
      "parameters": {
        "jsCode": "// ═══════════════════════════════════════════════════════\n// IMPORTAÇÃO HISTÓRICA COMPLETA DE CONTATOS (Evolution API -> Trello)\n// Processa TODOS os contatos da instância (atendimoveis_meta)\n// ═══════════════════════════════════════════════════════\n\nconst contactsItems = $input.all();\nconst cardsData = $(\"Agrupar Cards Trello\").first().json.cards || [];\n\n// Mapeia cards existentes no Trello para deduplicação rápida por número\nconst existingTexts = cardsData.map(card => {\n  return ((card.name || '') + ' ' + (card.desc || '')).toLowerCase();\n});\n\nconst newLeads = [];\nconst seenPhones = new Set();\n\nfor (const item of contactsItems) {\n  const c = item.json;\n  const rawJid = c.remoteJid || c.id || '';\n  if (!rawJid || rawJid.endsWith('@g.us') || c.isGroup) continue;\n\n  let phone = '';\n  if (rawJid.includes('@s.whatsapp.net') || rawJid.includes('@c.us')) {\n    phone = rawJid.split('@')[0];\n  } else {\n    const altJid = c.remoteJidAlt || '';\n    if (altJid.includes('@s.whatsapp.net') || altJid.includes('@c.us')) {\n      phone = altJid.split('@')[0];\n    }\n  }\n\n  if (!phone || phone.length < 10 || seenPhones.has(phone)) continue;\n  seenPhones.add(phone);\n\n  const alreadyExists = existingTexts.some(text => text.includes(phone));\n  if (!alreadyExists) {\n    const pushName = (c.pushName || c.profileName || c.name || '').trim();\n    const displayName = (pushName && pushName !== 'None') ? pushName : 'Desconhecido';\n    const now = new Date().toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' });\n\n    newLeads.push({\n      json: {\n        phone,\n        pushName: displayName,\n        cardTitle: displayName !== 'Desconhecido' ? `${displayName} (${phone})` : `Lead ${phone}`,\n        cardDescription:\n          `📲 Lead importado historicamente via WhatsApp\\n` +\n          `Fonte: Evolution API (Histórico)\\n\\n` +\n          `Nome: ${displayName}\\n` +\n          `Número: ${phone}\\n` +\n          `Importado em: ${now}`\n      }\n    });\n  }\n}\n\nreturn newLeads;"
      },
      "id": "node-compare-leads",
      "name": "Filtrar Apenas Novos Leads",
      "type": "n8n-nodes-base.code",
