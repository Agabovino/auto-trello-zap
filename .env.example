# n8n Configuration
N8N_HOST=n8n.seudominio.com.br
N8N_PORT=5678
N8N_PROTOCOL=https

# Webhook URL (Crucial for WhatsApp/Trello triggers)
WEBHOOK_URL=https://n8n.seudominio.com.br/

# Evolution API Public URL
SERVER_URL=https://evolution.seudominio.com.br

# Security - Generate a random string
N8N_ENCRYPTION_KEY=your_secure_random_key_here

# Localization
TIMEZONE=America/Sao_Paulo

# Cloudflare Tunnel Token (n8n)
TUNNEL_TOKEN=your_n8n_tunnel_token_here

# Cloudflare Tunnel Token (Evolution API)
TUNNEL_TOKEN_EVOLUTION=your_evolution_tunnel_token_here

# Cloudflare Tunnel Token (Dashboard — dashboard.seudominio.com.br)
TUNNEL_TOKEN_DASHBOARD=your_dashboard_tunnel_token_here

# Evolution API Key
EVOLUTION_API_KEY=your_evolution_api_key_here

# Instância da Evolution API que será a fonte dos leads (padrão: meu-numero)
EVOLUTION_INSTANCE=meu-numero

# Trello Credentials (obtenha em https://trello.com/power-ups/admin)
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=
TRELLO_LIST_ID=

# n8n Public API Key for Remote Control
N8N_API_KEY=your_n8n_api_key_here
