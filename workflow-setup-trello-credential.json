{
  "name": "⚙️ Setup: Criar Credencial Trello via ENV",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 0,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "node-schedule-trigger",
      "name": "Executar 1x ao dia (verificação)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        -600,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// ═══════════════════════════════════════════════════════\n// Verifica se as variáveis de ambiente do Trello estão definidas\n// Se não estiverem, encerra o fluxo silenciosamente\n// ═══════════════════════════════════════════════════════\n\nconst apiKey = (typeof $env !== 'undefined' && $env.TRELLO_API_KEY) || (typeof process !== 'undefined' && process.env && process.env.TRELLO_API_KEY) || '';\nconst token  = (typeof $env !== 'undefined' && $env.TRELLO_TOKEN)  || (typeof process !== 'undefined' && process.env && process.env.TRELLO_TOKEN)  || '';\n\nif (!apiKey || !token) {\n  return [{ json: { shouldSetup: false, reason: 'TRELLO_API_KEY ou TRELLO_TOKEN não definidos no .env' } }];\n}\n\nreturn [{ json: { shouldSetup: true, apiKey, token } }];"
      },
      "id": "node-check-env",
      "name": "Verificar Variáveis de Ambiente",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -380,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.shouldSetup }}",
              "value2": true
            }
          ]
        }
      },
      "id": "node-filter-setup",
      "name": "ENV Definido?",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 1,
      "position": [
        -160,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=http://localhost:5678/api/v1/credentials",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-API-KEY",
              "value": "={{ $env.N8N_API_KEY }}"
            }
          ]
        },
        "options": {}
      },
      "id": "node-list-credentials",
      "name": "Listar Credenciais Existentes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        60,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// ═══════════════════════════════════════════════════════\n// Verifica se já existe uma credencial Trello\n// Se existe, atualiza. Se não existe, cria.\n// ═══════════════════════════════════════════════════════\n\nconst envData = $('ENV Definido?').item.json;\nconst apiKey = envData.apiKey;\nconst token  = envData.token;\n\nconst credentialsResponse = $input.item.json;\nconst credentials = credentialsResponse.data || [];\n\n// Busca credencial Trello existente\nconst existingTrello = credentials.find(c => c.type === 'trelloApi');\n\nreturn [{\n  json: {\n    apiKey,\n    token,\n    existingId: existingTrello?.id || null,\n    credentialName: existingTrello?.name || 'Trello account',\n    action: existingTrello ? 'update' : 'create'\n  }\n}];"
      },
      "id": "node-check-existing",
      "name": "Verificar se Credencial Existe",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        280,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.action }}",
              "value2": "create"
            }
          ]
        }
      },
      "id": "node-filter-action",
      "name": "Criar ou Atualizar?",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 1,
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://localhost:5678/api/v1/credentials",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-API-KEY",
              "value": "={{ $env.N8N_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": []
        },
        "specifyBody": "json",
        "jsonBody": "={\n  \"name\": \"Trello account\",\n  \"type\": \"trelloApi\",\n  \"data\": {\n    \"apiKey\": \"{{ $json.apiKey }}\",\n    \"apiToken\": \"{{ $json.token }}\"\n  }\n}",
        "options": {}
      },
      "id": "node-create-credential",
      "name": "Criar Credencial Trello",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        720,
        160
      ]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=http://localhost:5678/api/v1/credentials/{{ $json.existingId }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-API-KEY",
              "value": "={{ $env.N8N_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"name\": \"{{ $json.credentialName }}\",\n  \"data\": {\n    \"apiKey\": \"{{ $json.apiKey }}\",\n    \"apiToken\": \"{{ $json.token }}\"\n  }\n}",
        "options": {}
      },
      "id": "node-update-credential",
      "name": "Atualizar Credencial Trello",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        720,
        440
      ]
    }
  ],
  "connections": {
    "Executar 1x ao dia (verificação)": {
      "main": [
        [
          {
            "node": "Verificar Variáveis de Ambiente",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Verificar Variáveis de Ambiente": {
      "main": [
        [
          {
            "node": "ENV Definido?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "ENV Definido?": {
      "main": [
        [
          {
            "node": "Listar Credenciais Existentes",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Listar Credenciais Existentes": {
      "main": [
        [
          {
            "node": "Verificar se Credencial Existe",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Verificar se Credencial Existe": {
      "main": [
        [],
        [
          {
            "node": "Atualizar Credencial Trello",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Criar ou Atualizar?": {
      "main": [
        [
          {
            "node": "Criar Credencial Trello",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveExecutionProgress": false,
    "saveSuccessfulExecutions": false,
    "saveDataSuccessExecution": "none"
  },
  "staticData": null,
  "meta": {
    "templateCredsSetupCompleted": true
  },
  "pinData": {},
  "tags": []
}